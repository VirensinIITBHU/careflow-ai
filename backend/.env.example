# Copy to backend/.env and fill in the keys. Never commit .env.
HF_TOKEN=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Structured extraction + translation: gpt-oss-20b on Groq
EXTRACT_PROVIDER=groq
EXTRACT_MODEL=openai/gpt-oss-20b
EXTRACT_FALLBACK_MODEL=openai/gpt-oss-20b

# Speech-to-text: Whisper large v3 on Groq
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3
STT_LOW_CONF=0.55

# Report images (OCR): Nemotron on OpenRouter. If the primary returns no transcription
# (it is a safety-classifier model), the pipeline automatically retries with the fallback.
VISION_PROVIDER=openrouter
VISION_MODEL=nvidia/nemotron-3.5-content-safety:free
VISION_FALLBACK_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# Optional second safety reader (adds flags only, never removes them)
SECOND_READER=on
SECOND_READER_PROVIDER=groq
SECOND_READER_MODEL=openai/gpt-oss-20b
SECOND_READER_MAX_TOKENS=6000
SECOND_READER_TIMEOUT=90

LOCAL_BASE_URL=http://localhost:11434/v1

DEMO_PASSWORD=careflow-demo
SESSION_TTL_HOURS=8
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
