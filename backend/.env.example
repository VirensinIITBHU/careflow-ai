# Copy to backend/.env and fill in the keys. Never commit .env.
GROQ_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=

# Structured extraction + translation: gpt-oss-20b on Groq
EXTRACT_PROVIDER=groq
EXTRACT_MODEL=openai/gpt-oss-20b
EXTRACT_FALLBACK_MODEL=openai/gpt-oss-20b

# Live interview copilot: a small, fast model for next-question suggestions (rules work without it).
COPILOT_PROVIDER=groq
COPILOT_MODEL=llama-3.1-8b-instant
COPILOT_TIMEOUT=8
COPILOT_LLM=on

# Speech-to-text: Whisper large v3 on Groq
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3
STT_LOW_CONF=0.55

# Report images (OCR): a vision-language model on OpenRouter, with a fallback.
VISION_PROVIDER=openrouter
VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
VISION_FALLBACK_MODEL=google/gemma-3-27b-it:free

# Optional second safety reader (adds flags only, never removes them). Runs in parallel with extraction.
SECOND_READER=on
SECOND_READER_PROVIDER=groq
SECOND_READER_MODEL=openai/gpt-oss-20b
SECOND_READER_MAX_TOKENS=6000
SECOND_READER_TIMEOUT=90

LOCAL_BASE_URL=http://localhost:11434/v1

# Provider response cache: off | record | replay | auto. Synthetic data only.
LLM_CACHE=off
# Seed synthetic demo cases when the database is empty.
SEED_DEMO=on

DEMO_PASSWORD=careflow-demo
SESSION_TTL_HOURS=8
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGIN_REGEX=https://careflow-ai-.*\.vercel\.app
